{
  "version": 2,
  "builds": [
    { 
      "src": "js/server.js", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "css/**",
          "js/**",
          "img/**",
          "lib/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "js/server.js"
    }
  ]
}
